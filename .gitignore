# ============================================================
# Allowlist: this public repository contains ONLY the files needed
# to reproduce the paper's calculations and figures. Everything
# else (manuscripts, submissions, screenshots, notes, archives,
# side projects) is ignored by default and stays on the local disk.
# ============================================================

# Ignore everything at the top level...
/*

# ...except these
!/.gitignore
!/README.md
!/LICENSE
!/FIFA_worldCup_2026_risk.Rproj
!/Code/
!/Data/
!/Figures/

# Code: final R scripts only
/Code/*
!/Code/*.R

# Figures: the paper's figures only (Figure1-4, FigureS1-S9)
/Figures/*
!/Figures/Figure[0-9]*.png
!/Figures/Figure[0-9]*.pdf
!/Figures/FigureS[0-9]*.png
!/Figures/FigureS[0-9]*.pdf

# Data: large, auto-downloaded, or local-only files
# BTS T-100 raw files: download from https://www.transtats.bts.gov
/Data/Data_BTS/
# FluNet (~30 MB): downloaded automatically by Code/importationRisk_main.R
/Data/flunet_viwfnt.csv
/Data/Not_currently_used/

# System and R session files, anywhere
.DS_Store
.Rhistory
.RData
.Rproj.user/
